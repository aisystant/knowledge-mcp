{
  "name": "knowledge-mcp",
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm ci --legacy-peer-deps && npm run test && npm run typecheck && npm run guard:privacy && bash scripts/verified-deploy.sh",
    "guard:privacy": "bash scripts/check-account-id-filter.sh",
    "typecheck": "tsc --noEmit",
    "typecheck:evaluation": "tsc --noEmit -p tsconfig.evaluation.json",
    "eval:retrieval": "node --import tsx scripts/evaluate-retrieval.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:all": "tsx scripts/ingest.ts --config scripts/sources.json",
    "ingest:platform": "tsx scripts/ingest.ts --config scripts/sources-platform.json",
    "ingest:personal": "tsx scripts/ingest.ts --config scripts/sources-personal.json",
    "schema": "psql $DATABASE_URL -f schema.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^22.15.30",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "jose": "^6.2.12"
  }
}
